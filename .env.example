# OwnAI – Environment Configuration
# Copy this file to .env and edit as needed.
# python-dotenv will load it automatically when present.

# ── Flask ────────────────────────────────────────────────────────────────────
# Secret key for session signing. Set to a long random string in production!
SECRET_KEY=change-me-to-a-long-random-string

# Port to listen on (default: 5000)
PORT=5000

# Set to "production" to disable debug output
FLASK_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Defaults to ownai.db (SQLite) in the project root.
# For Postgres: DATABASE_URL=postgresql://user:pass@host:5432/ownai
# DATABASE_URL=

# ── Storage ──────────────────────────────────────────────────────────────────
# Where trained model checkpoints are saved
# MODELS_DIR=./models_dir

# Where uploaded dataset files are saved
# UPLOADS_DIR=./uploads

# ── HuggingFace ──────────────────────────────────────────────────────────────
# Optional: your HF token for downloading gated models (Llama, Gemma, etc.)
# HUGGINGFACE_HUB_TOKEN=hf_...

# ── GPU / Performance ────────────────────────────────────────────────────────
# Which CUDA device to use (0 = first GPU, -1 = CPU only)
# CUDA_VISIBLE_DEVICES=0

# Max upload size in MB (default: 500)
# MAX_UPLOAD_MB=500
